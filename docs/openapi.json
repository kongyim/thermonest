  "components": {
    "schemas": {
      "BindKeyInput": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$",
            "title": "Key"
          }
        },
        "type": "object",
        "required": [
          "key"
        ],
        "title": "BindKeyInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RoomInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "sort_order": {
            "type": "integer",
            "title": "Sort Order",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "RoomInput"
      },
      "SensorCreate": {
        "properties": {
          "device_identifier": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Device Identifier"
          },
          "display_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name"
          },
          "room_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room Id"
          }
        },
        "type": "object",
        "required": [
          "device_identifier",
          "display_name"
        ],
        "title": "SensorCreate"
      },
      "SensorPatch": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "room_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room Id"
          },
          "device_identifier": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Identifier"
          }
        },
        "type": "object",
        "title": "SensorPatch"
      },
      "SettingsPatch": {
        "properties": {
          "battery_mode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(passive|balanced|custom)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery Mode"
          },
          "sampling_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3600.0,
                "minimum": 30.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sampling Seconds"
          },
          "theme": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(system|light|dark)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SettingsPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
